{
 "version": "0.4",
 "note": "Concept catalogue for the NTR skill. Concepts use the same names as the AI Living World Atlas so this can later read from it. Sources: OpenStreetMap (Overpass), GBIF and Wikidata.",
 "sources": {
  "osm-overpass": {
   "name": "OpenStreetMap via Overpass API",
   "publisher": "OpenStreetMap contributors",
   "authority": "community",
   "endpoint": "https://overpass-api.de/api/interpreter",
   "licence": {
    "name": "ODbL 1.0",
    "url": "https://www.openstreetmap.org/copyright",
    "attribution": "© OpenStreetMap contributors"
   },
   "caveat": "Coverage varies by country. Missing features are not evidence of absence."
  },
  "gbif": {
   "name": "GBIF occurrence search, filtered by IUCN Red List category",
   "publisher": "Global Biodiversity Information Facility",
   "authority": "aggregator of museum, survey and citizen-science records",
   "endpoint": "https://api.gbif.org/v1/occurrence/search",
   "licence": {
    "name": "Per record: CC0, CC BY 4.0 or CC BY-NC 4.0",
    "url": "https://www.gbif.org/terms",
    "attribution": "GBIF.org; cite the datasets used"
   },
   "caveat": "Records, not ranges. Sampling is very uneven and sensitive species may be blurred. Red List categories themselves are free to use; IUCN range maps are not used."
  },
  "wikidata": {
   "name": "Wikidata Query Service",
   "publisher": "Wikimedia Foundation and contributors",
   "authority": "community",
   "endpoint": "https://query.wikidata.org/sparql",
   "licence": {
    "name": "CC0 1.0",
    "url": "https://www.wikidata.org/wiki/Wikidata:Licensing",
    "attribution": "Wikidata"
   },
   "caveat": "Point locations only. Useful as a gazetteer and for Wikipedia links to start desk research."
  }
 },
 "concepts": {
  "protected-area": {
   "label": "Protected area",
   "ps": "PS6",
   "source": "osm-overpass",
   "radius_km": 20,
   "containing": true,
   "match": [
    [
     "boundary",
     "protected_area"
    ],
    [
     "boundary",
     "national_park"
    ],
    [
     "leisure",
     "nature_reserve"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "world-heritage": {
   "label": "World Heritage site",
   "ps": "PS6 / PS8",
   "source": "osm-overpass",
   "radius_km": 20,
   "containing": true,
   "match": [
    [
     "heritage",
     "1"
    ],
    [
     "heritage:operator",
     "whc"
    ]
   ],
   "osm_types": [
    "node",
    "way",
    "relation"
   ],
   "note": "Natural and mixed sites count for PS6, cultural and mixed for PS8. Often mapped as a point, so distances to large sites are approximate."
  },
  "ramsar-site": {
   "label": "Ramsar wetland",
   "ps": "PS6",
   "source": "osm-overpass",
   "radius_km": 20,
   "containing": true,
   "match": [
    [
     "designation",
     "~ramsar"
    ],
    [
     "protection_title",
     "~ramsar"
    ],
    [
     "ramsar",
     "*"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ],
   "note": "OSM tagging of Ramsar sites is inconsistent; treat as partial."
  },
  "wetland": {
   "label": "Wetland",
   "ps": "PS6",
   "source": "osm-overpass",
   "radius_km": 5,
   "containing": true,
   "match": [
    [
     "natural",
     "wetland"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "river": {
   "label": "River",
   "ps": "PS6",
   "source": "osm-overpass",
   "radius_km": 5,
   "match": [
    [
     "waterway",
     "river"
    ]
   ],
   "osm_types": [
    "way"
   ]
  },
  "forest": {
   "label": "Forest or woodland",
   "ps": "PS6",
   "source": "osm-overpass",
   "radius_km": 2,
   "containing": true,
   "match": [
    [
     "landuse",
     "forest"
    ],
    [
     "natural",
     "wood"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "threatened-species": {
   "label": "Threatened species records (CR, EN)",
   "ps": "PS6",
   "source": "gbif",
   "radius_km": 5,
   "wider_km": 20
  },
  "indigenous-land": {
   "label": "Indigenous or community land",
   "ps": "PS7",
   "source": "osm-overpass",
   "radius_km": 20,
   "containing": true,
   "match": [
    [
     "boundary",
     "aboriginal_lands"
    ],
    [
     "protect_class",
     "24"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "settlement": {
   "label": "Settlement",
   "ps": "PS5",
   "source": "osm-overpass",
   "radius_km": 20,
   "match": [
    [
     "place",
     "city"
    ],
    [
     "place",
     "town"
    ],
    [
     "place",
     "village"
    ],
    [
     "place",
     "hamlet"
    ],
    [
     "place",
     "isolated_dwelling"
    ]
   ],
   "osm_types": [
    "node"
   ]
  },
  "residential-land": {
   "label": "Residential land",
   "ps": "PS5",
   "source": "osm-overpass",
   "radius_km": 2,
   "containing": true,
   "match": [
    [
     "landuse",
     "residential"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "informal-settlement": {
   "label": "Informal settlement",
   "ps": "PS5",
   "source": "osm-overpass",
   "radius_km": 5,
   "containing": true,
   "match": [
    [
     "informal",
     "yes"
    ],
    [
     "residential",
     "informal"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ],
   "note": "Rarely mapped. Absence means nothing."
  },
  "farmland": {
   "label": "Farmland or orchard",
   "ps": "PS5",
   "source": "osm-overpass",
   "radius_km": 1,
   "containing": true,
   "match": [
    [
     "landuse",
     "farmland"
    ],
    [
     "landuse",
     "orchard"
    ],
    [
     "landuse",
     "meadow"
    ],
    [
     "landuse",
     "farmyard"
    ]
   ],
   "osm_types": [
    "way"
   ]
  },
  "industrial-land": {
   "label": "Industrial or port land",
   "ps": "PS5",
   "source": "osm-overpass",
   "radius_km": 1,
   "containing": true,
   "match": [
    [
     "landuse",
     "industrial"
    ],
    [
     "landuse",
     "port"
    ]
   ],
   "osm_types": [
    "way",
    "relation"
   ]
  },
  "heritage-site": {
   "label": "Heritage or historic site",
   "ps": "PS8",
   "source": "osm-overpass",
   "radius_km": 5,
   "match": [
    [
     "heritage",
     "*"
    ],
    [
     "historic",
     "*"
    ]
   ],
   "osm_types": [
    "node",
    "way"
   ]
  },
  "place-of-worship": {
   "label": "Place of worship or cemetery",
   "ps": "PS8",
   "source": "osm-overpass",
   "radius_km": 2,
   "match": [
    [
     "amenity",
     "place_of_worship"
    ],
    [
     "landuse",
     "cemetery"
    ],
    [
     "amenity",
     "grave_yard"
    ]
   ],
   "osm_types": [
    "node",
    "way"
   ]
  },
  "community-facility": {
   "label": "School or health facility",
   "ps": "PS4",
   "source": "osm-overpass",
   "radius_km": 5,
   "match": [
    [
     "amenity",
     "school"
    ],
    [
     "amenity",
     "hospital"
    ],
    [
     "amenity",
     "clinic"
    ]
   ],
   "osm_types": [
    "node",
    "way"
   ]
  },
  "energy-infrastructure": {
   "label": "Existing energy infrastructure",
   "ps": "PS4",
   "source": "osm-overpass",
   "radius_km": 5,
   "match": [
    [
     "power",
     "plant"
    ],
    [
     "power",
     "substation"
    ],
    [
     "man_made",
     "pipeline"
    ]
   ],
   "osm_types": [
    "node",
    "way"
   ]
  },
  "named-places": {
   "label": "Named places and features (for desk research)",
   "ps": "context",
   "source": "wikidata",
   "radius_km": 20
  },
  "main-road": {
   "label": "Main road",
   "ps": "context",
   "source": "osm-overpass",
   "radius_km": 10,
   "match": [
    [
     "highway",
     "~^(motorway|trunk|primary|secondary)$"
    ]
   ],
   "osm_types": [
    "way"
   ],
   "note": "Access. No main road within 10 km means a new access road is likely: land take (PS5) and induced access (PS6)."
  },
  "international-boundary": {
   "label": "International or disputed boundary",
   "ps": "context",
   "source": "osm-overpass",
   "radius_km": 20,
   "match": [
    [
     "boundary",
     "disputed"
    ],
    [
     "admin_level",
     "2"
    ]
   ],
   "osm_types": [
    "way"
   ],
   "note": "Country risk and PS4 security context. admin_level=2 ways are national borders; boundary=disputed marks contested lines."
  }
 }
}