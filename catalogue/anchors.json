{
  "version": "0.1",
  "note": "Named-feature sources the place-finding tools search for anchors, besides OpenStreetMap (Nominatim) and Natural Earth. Each entry is a dataset in the AI Living World Atlas (atlas_id), with the fields needed to search it by name or reference. Licence is as the atlas records it; empty means the atlas record doesn't state one.",
  "atlas": "https://github.com/pushpingeo/ai-living-world-atlas",
  "sources": [
    {
      "id": "nsta-surface-installations",
      "atlas_id": "ccf3d4481f921797",
      "title": "UKCS offshore infrastructure surface points (WGS84)",
      "publisher": "North Sea Transition Authority",
      "licence": "",
      "landing_page": "https://open-data-ukcs-transition.hub.arcgis.com/datasets/UKCS-transition::ukcs-offshore-infrastructure-surface-points-wgs84",
      "url": "https://services-eu1.arcgis.com/OZMfUznmLTnWccBc/arcgis/rest/services/UKCS%20offshore%20infrastructure%20surface%20points%20WGS84/FeatureServer/1",
      "coverage": [-25, 47, 4, 64],
      "kind": "offshore installation",
      "search": "name",
      "name_field": "NAME",
      "type_field": "INF_TYPE",
      "extra_fields": ["DESCRIPTIO", "REP_GROUP", "STATUS", "CRS_NAME"],
      "where": "CURR_ROW = 'Y'"
    },
    {
      "id": "nsta-fields",
      "atlas_id": "ec6cbc6727d51fb9",
      "title": "UKCS offshore hydrocarbon fields (WGS84)",
      "publisher": "North Sea Transition Authority",
      "licence": "NSTA Open User Licence",
      "landing_page": "https://open-data-ukcs-transition.hub.arcgis.com/datasets/UKCS-transition::ukcs-offshore-hydrocarbon-fields-wgs84",
      "url": "https://services-eu1.arcgis.com/OZMfUznmLTnWccBc/arcgis/rest/services/Offshore_hydrocarbon_fields_(WGS84)/FeatureServer/0",
      "coverage": [-25, 47, 4, 64],
      "kind": "oil or gas field",
      "search": "name",
      "name_field": "FIELDNAME",
      "type_field": "FIELDTYPE",
      "extra_fields": ["STATUS", "CURR_OPER"]
    },
    {
      "id": "nsta-blocks",
      "atlas_id": "b7511d28c5973e49",
      "title": "UKCS blocks (WGS84)",
      "publisher": "North Sea Transition Authority",
      "licence": "",
      "landing_page": "https://open-data-ukcs-transition.hub.arcgis.com/datasets/UKCS-transition::ukcs-blocks-wgs84",
      "url": "https://services-eu1.arcgis.com/OZMfUznmLTnWccBc/arcgis/rest/services/UKCS_blocks_(WGS84)/FeatureServer/0",
      "coverage": [-25, 47, 4, 64],
      "kind": "UK offshore licensing block",
      "search": "block_ref",
      "name_field": "BLOCK_REF",
      "type_field": "TYPE",
      "extra_fields": []
    }
  ]
}
